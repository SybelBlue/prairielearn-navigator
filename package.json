{
  "name": "prairielearn-navigator",
  "displayName": "prairielearn-navigator",
  "description": "provides definitions and inlay hints for prairielearn assessments and questions",
  "version": "0.2.1",
  "publisher": "sybelblue",
  "repository": {
    "type": "git",
    "url": "https://github.com/SybelBlue/prairielearn-navigator.git"
  },
  "engines": {
    "vscode": "^1.106.1",
    "node": ">=22"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:**/infoCourse.json",
    "workspaceContains:**/infoInstanceCourse.json",
    "workspaceContains:**/infoAssessment.json",
    "workspaceContains:**/questions/**/info.json"
  ],
  "main": "./dist/extension.js",
  "bin": {
    "prairielearn-navigator": "dist/cli.js"
  },
  "contributes": {
    "commands": [
      {
        "command": "prairielearn-navigator.helloWorld",
        "title": "Hello World"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "prepare": "webpack --mode production",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:cli": "vitest run",
    "check": "node dist/cli.js check",
    "bundle": "npm test && vsce package",
    "publish:vscode": "npm test && vsce publish",
    "publish:vscode:patch": "npm test && vsce publish patch",
    "publish:vscode:minor": "npm test && vsce publish minor",
    "publish:vscode:major": "npm test && vsce publish major"
  },
  "devDependencies": {
    "@types/json-to-pretty-yaml": "^1.2.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.1",
    "@types/vscode": "^1.106.1",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^9.39.1",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "vitest": "^5.0.3",
    "webpack": "^5.102.1",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "json-to-pretty-yaml": "^1.2.2"
  }
}
