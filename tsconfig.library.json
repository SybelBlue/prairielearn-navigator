{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "stripInternal": true,
    "outDir": "packages/cli/dist",
    "rootDir": "src"
  },
  // Declarations are emitted for everything library.ts reaches; package.json
  // "files" lists the ones that are published.
  "include": ["src/library.ts"]
}
