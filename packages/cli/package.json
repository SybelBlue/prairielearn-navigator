{
  "name": "@sybelblue/prairielearn-navigator",
  "version": "1.2.2",
  "description": "Check PrairieLearn courses and update semantic QID references",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SybelBlue/prairielearn-navigator.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/core/questionFileResolver.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "prairielearn-navigator": "dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "dist/index.js",
    "dist/shared.js",
    "dist/core/questionFileResolver.d.ts"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "prairielearn",
    "lint",
    "cli",
    "ci"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "npm --prefix ../.. run build:npm && cp ../../LICENSE .",
    "prepublishOnly": "npm --prefix ../.. run lint && npm --prefix ../.. run test:cli"
  }
}
